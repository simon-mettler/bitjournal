# Copy to .env and adjust: cp .env.example .env
# Variables marked REQUIRED have no usable default.

### DJANGO ---------------------------------------------------------------
# REQUIRED. Long random string, keep it secret. Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# REQUIRED. Comma-separated hostnames the app is served under, no scheme or port.
# Example: bitjournal.example.com (use localhost when testing local)
ALLOWED_HOSTS=localhost

# Comma-separated origins (with scheme) trusted for CSRF, e.g. the admin login
# behind a reverse proxy. Example: https://bitjournal.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Only honored when DEBUG=true (Vite dev server). Leave empty in production,
# the app is served same-origin.
CORS_ALLOWED_ORIGINS=

# Keep false in production.
DEBUG=false

### DATABASE -------------------------------------------------------------
DB_NAME=bitjournal
DB_USER=bitjournal
# REQUIRED. Pick a strong password.
DB_PASSWORD=
# These two only matter when running the backend outside compose.
DB_HOST=db
DB_PORT=5432

### INSTANCE -------------------------------------------------------------
# Set to false to close sign-ups (registration returns 403, /register redirects to login).
REGISTRATION_ENABLED=true

# Optional message shown to users, exposed via GET /api/config/.
INSTANCE_NOTICE=

# EMAIL ------------------------------------------------------------------
# Enabled only when both EMAIL_HOST and DEFAULT_FROM_EMAIL are set.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# DOCKER ----------------------------------------------------------------
# Host port the app is published on.
APP_PORT=8000

# Gunicorn worker processes.
WEB_CONCURRENCY=3

# Seconds the entrypoint waits for the database before giving up.
DB_WAIT_TIMEOUT=60

# Optional: name prefix for compose containers/volumes (default: directory name).
# COMPOSE_PROJECT_NAME=bitjournal
